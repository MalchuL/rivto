{

  "compilerOptions": {
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "composite": true,
    "paths": {
      "@/store/crdt-doc": [
        "./src/store/crdt-doc"
      ],
      "@/store/document-model": [
        "./src/store/document-model"
      ],
      "@/utils": [
        "./src/utils"
      ]
    }
  },
  "include": ["src/**/*"]
}


