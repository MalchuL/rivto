{
  "type": "module",
  "name": "@chulane/rivto-keyboard",
  "version": "0.1.0",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist/esm",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "../../scripts/run-test.sh --runInBand",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --out-dir dist/esm --watch src",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "5.8.3"
  },
  "files": [
    "dist/esm"
  ]
}
