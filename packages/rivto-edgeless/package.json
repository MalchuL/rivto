{
  "name": "@chulane/rivto-edgeless",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/react.ts --format esm --dts --sourcemap --clean",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "NODE_OPTIONS=--experimental-vm-modules ../../scripts/run-test.sh --runInBand",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "demo": "vite demo --host 127.0.0.1 --port 5198 --strictPort",
    "demo:build": "tsc --project demo/tsconfig.json --noEmit && vite build demo",
    "demo:preview": "vite preview demo --host 127.0.0.1 --port 5198 --strictPort",
    "demo:check": "tsc --project demo/tsconfig.json --noEmit",
    "demo:test": "playwright test --config demo/playwright.config.ts --workers=12"
  },
  "dependencies": {
    "react-moveable": "^0.56.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "vite": "^7.3.6"
  }
}
