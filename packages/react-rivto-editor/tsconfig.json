{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@chulane/crdt-doc": [
        "../crdt-doc/src/index.ts"
      ],
      "@chulane/document-model": [
        "../document-model/src/index.ts"
      ],
      "@chulane/rivto": [
        "../rivto-editor-core/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
