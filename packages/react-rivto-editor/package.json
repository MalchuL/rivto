{
  "name": "@chulane/rivto-react",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/esm",
    "styles.css",
    "todo-item.css",
    "docs"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./extensions": {
      "import": "./dist/esm/extensions.js",
      "types": "./dist/esm/extensions.d.ts",
      "default": "./dist/esm/extensions.js"
    },
    "./styles.css": "./styles.css",
    "./todo-item.css": "./todo-item.css"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup src/index.ts src/extensions.ts --format esm --dts --sourcemap --clean --out-dir dist/esm",
    "dev": "tsup src/index.ts src/extensions.ts --format esm --dts --sourcemap --clean --out-dir dist/esm --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "NODE_OPTIONS=--experimental-vm-modules ../../scripts/run-test.sh --runInBand",
    "ui:add": "node scripts/shadcn-add.mjs"
  },
  "dependencies": {
    "@chulane/rivto": "workspace:*",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest": "^29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.8.3"
  }
}
