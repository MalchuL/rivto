{
  "name": "@chulane/rivto",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/esm"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist/esm",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist/esm --watch",
    "test": "../../scripts/run-test.sh",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "resolve": "1.22.12",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "yjs": "^13.0.0"
  },
  "dependencies": {
    "y-webrtc": "^10.3.0",
    "zod": "^4.1.13"
  }
}
