{
  "name": "@chulane/rivto",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/esm"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist/esm",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist/esm --watch",
    "demo": "pnpm -r --parallel --include-workspace-root --filter @chulane/rivto --filter @chulane/rivto-demo dev",
    "demo:build": "pnpm build && pnpm --dir demo build",
    "demo:check": "pnpm --dir demo check-types",
    "lint": "eslint src --max-warnings=0",
    "test": "scripts/run-test.sh",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsdoc": "^63.0.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.46.0",
    "yjs": "^13.0.0"
  },
  "dependencies": {
    "y-webrtc": "^10.3.0",
    "zod": "^4.1.13"
  }
}
