{
  "name": "@chulane/rivto",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "lint": "eslint .",
    "test": "jest",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/uuid": "^11.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "5.8.3",
    "yjs": "^13.0.0"
  },
  "dependencies": {
    "uuid": "^13.0.0",
    "y-webrtc": "^10.3.0",
    "zod": "^4.1.13"
  }
}
