# Browser-reachable API origin, injected at request time (no rebuild needed).
# Unused while storage is mocked in-memory; wired for the future real backend.
PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Server-only base URL for Next Route Handlers proxying to the API
# (e.g. http://backend:4000 on a Compose network).
SERVER_API_BASE_URL=http://127.0.0.1:4000
