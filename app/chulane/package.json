{
  "name": "@chulane/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:runtime && node dist/src/runtime/server.js --development",
    "build": "pnpm build:runtime && next build",
    "start": "node dist/src/runtime/server.js",
    "lint": "eslint",
    "dev:desktop": "pnpm build:runtime && electron . --development",
    "start:desktop": "electron .",
    "check-types": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "test:unit": "pnpm build:runtime && node dist/scripts/test-unit.js",
    "test:smoke": "pnpm build && playwright test",
    "test": "pnpm test:unit && pnpm test:smoke",
    "build:runtime": "tsc -p tsconfig.runtime.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.525.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "37.10.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "type": "module",
  "main": "dist/electron/main.js"
}
