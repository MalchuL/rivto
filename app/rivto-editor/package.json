{
  "name": "@chulane/rivto-editor-app",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --experimental-strip-types tests/documents.test.ts && node --experimental-strip-types tests/files.test.ts",
    "start": "electron .",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "eslint src renderer tests scripts vite.config.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "electron": "37.10.3",
    "typescript": "5.8.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "vite": "7.3.6",
    "@playwright/test": "1.61.1",
    "eslint": "9.39.4",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "description": "Local-first Rivto text editor",
  "dependencies": {
    "@chulane/rivto": "workspace:*",
    "@chulane/rivto-react": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
